PORT=5001
NODE_ENV=development

# MongoDB Atlas — replace with your connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/revenue-recovery?retryWrites=true&w=majority

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=10000

# AI Mode — set to "false" to use real Gemini API
USE_MOCK_AI=true

# App Config
MAX_RETRY_ATTEMPTS=5
AI_CONFIDENCE_THRESHOLD=0.5
MAX_AUTO_RECOVERY_AMOUNT=100000

# ─── Payment Processing System Integration (Phase 2) ────────────────────────

# Base URL of the Payment Processing System
# Local development: http://localhost:5000
# Production: https://payment-processing-system-sz7e.onrender.com
PAYMENT_PROCESSING_URL=http://localhost:5000

# Shared secret for internal service-to-service API calls
# Must match INTERNAL_API_KEY in Payment Processing System's .env
# BACKEND-ONLY — NEVER expose in VITE_* variables or frontend code
INTERNAL_API_KEY=your_internal_api_key_here

# Webhook signature verification secret
# Must match WEBHOOK_SECRET in Payment Processing System's .env
# BACKEND-ONLY — NEVER expose in VITE_* variables or frontend code
WEBHOOK_SECRET=your_webhook_secret_here
