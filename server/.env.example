PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/revenue-recovery?retryWrites=true&w=majority

# Gemini AI
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=10000
USE_MOCK_AI=true

# Recovery policy
MAX_RETRY_ATTEMPTS=5
AI_CONFIDENCE_THRESHOLD=0.5
MAX_AUTO_RECOVERY_AMOUNT=100000

# Payment Processing System integration
# Local: http://localhost:5000
# Render: https://<deployed-payment-processing-system-url>
PAYMENT_PROCESSING_URL=http://localhost:5000
PPS_REQUEST_TIMEOUT_MS=15000

# Backend-only secrets. Never expose these through VITE_* or frontend code.
# INTERNAL_API_KEY must match PPS INTERNAL_API_KEY.
INTERNAL_API_KEY=replace_with_shared_internal_api_key

# WEBHOOK_SECRET verifies PPS payment.failed webhooks.
# It must match the secret PPS uses when sending Recovery Agent webhooks.
WEBHOOK_SECRET=replace_with_shared_webhook_secret